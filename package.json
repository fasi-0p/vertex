{
  "name": "vertex",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "build:cli": "bun run --filter @vertex/cli build",
    "link:cli": "bun run build:cli && cd packages/cli && bun link"
  },
  "devDependencies": {
    "@opentui/core-win32-x64": "0.3.4",
    "@types/bun": "^1.3.14"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.28",
    "dotenv": "17.4.2"
  }
}