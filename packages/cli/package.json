{
  "name": "@vertex/cli",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin":{
    "vertex":"./bin/vertex"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun --external @opentui/core-darwin-arm64 --external @opentui/core-darwin-x64 --external @opentui/core-linux-arm64 --external @opentui/core-linux-arm64-musl --external @opentui/core-linux-x64 --external @opentui/core-linux-x64-musl --external @opentui/core-win32-arm64 --external @opentui/core-win32-x64"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@vertex/server": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.69",
    "@opentui/core": "^0.3.4",
    "@opentui/react": "^0.3.4",
    "@vertex/database": "workspace:*",
    "@vertex/shared": "workspace:*",
    "ai": "7.0.66",
    "date-fns": "4.1.0",
    "hono": "^4.12.27",
    "open": "11.0.0",
    "opentui-spinner": "0.0.6",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.6",
    "react-router": "7.14.0",
    "zod": "^4.4.3"
  }
}