    "postinstall":"bun run --cwd ../database db:generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.5",
    "@ai-sdk/google": "^4.0.6",
    "@ai-sdk/openai": "^4.0.5",
    "@hono/zod-validator": "0.7.6",
    "@vertex/database": "workspace:*",
    "@vertex/shared": "workspace:*",
    "ai": "^7.0.11",
    "dotenv": "^17.4.2",
    "hono": "^4.12.27",
    "zod": "4.3.6"
  }
}